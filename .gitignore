# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# editor uploads are user content, not repository assets
/public/uploads/
/uploads/

# tooling files created by `prisma init` (agent skills, not project sources)
.agents/
.claude/
.windsurf/
skills-lock.json

# logs and scratch files
*.log
dev-*.log

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files — only the committed template is tracked
.env
.env.*
!.env.example

# sqlite database (dev.db plus its journal/WAL/SHM sidecars)
*.db
*.db-*
dev.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client is generated by `postinstall: prisma generate`
/src/generated/prisma
