# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# editor uploads are user content, not repository assets
/public/uploads/
/uploads/

# tooling files created by `prisma init` (agent skills, not project sources)
.agents/
.claude/
.windsurf/
skills-lock.json

# logs and scratch files
*.log
dev-*.log

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files — only the committed template is tracked
.env
.env.*
!.env.example

# sqlite database (dev.db plus its journal/WAL/SHM sidecars)
*.db
*.db-*
dev.db

# database backups
#
# Копия боевой SQLite — это полная копия `.env`-значений, которые Prisma и приложение держат
# в таблице настроек: токены Telegram, VK и MAX. На сервере такие файлы лежат рядом с базой
# (`prisma/dev.db.bak-*`), и `git reset --hard` в `deploy.sh` их не трогает — они остаются
# untracked и однажды попадают в коммит целиком вместе с секретами.
*.bak
*.bak-*
*.db.bak*
*-wal
*-shm

# scratch files the scripts and the webmaster verification drop into the project root.
# Measured on the server 13 October: two untracked files sitting next to the repository —
# a VK dedupe backup (a list of deleted wall post ids) and the Yandex webmaster
# verification page. Neither belongs in the tree, and an untracked file is one `git add -A`
# away from being committed.
vk-dedupe-backup-*.json
yandex_*.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client is generated by `postinstall: prisma generate`
/src/generated/prisma
