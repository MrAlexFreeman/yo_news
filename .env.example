# SQLite database file, relative to the project root.
# Used by the Prisma CLI (via prisma7.config.ts) and by the app at runtime.
DATABASE_URL="file:./dev.db"

# Absolute base URL of the site. Used to build absolute links in the RSS feed
# and in VK posts. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where uploaded media is stored on disk. Defaults to <project>/uploads.
# On Render the filesystem is ephemeral — point this at a mounted disk,
# otherwise every uploaded cover disappears on redeploy.
UPLOAD_DIR=""

# Yandex Dzen RSS feed. Register this URL in the Dzen admin panel.
NEXT_PUBLIC_DZEN_FEED_URL="http://localhost:3000/api/feed/dzen.xml"

# VK community link shown to readers in the footer.
NEXT_PUBLIC_VK_URL="https://vk.ru/eartnews"

# Reader subscribe block (article footer and home sidebar).
# Telegram is optional: leave it empty and the button is not rendered at all,
# rather than pointing readers at a channel that does not exist.
NEXT_PUBLIC_DZEN_URL="https://dzen.ru/"
NEXT_PUBLIC_TG_URL=""

# Yandex Metrika counter, shown in the public pages only.
# The number is the counter id from metrika.yandex.ru (Установка счётчика).
# Deliberately no default in the code: with this empty the counter is not rendered,
# because a hardcoded fallback would send our readers' data to a counter that may not
# be ours — silently, and wrong only in somebody else's report.
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
# Session recording (Webvisor). On unless set to "false".
# Worth a decision rather than a default: Webvisor records what a visitor *types*,
# which on this site includes the forum form, not only where they click.
NEXT_PUBLIC_YANDEX_METRIKA_WEBVISOR="true"

# VK community for auto-reposts.
# Accepts "-241944021", "241944021", "https://vk.ru/club241944021",
# "public241944021" or a custom short name such as "https://vk.ru/eartnews";
# owner_id is derived automatically. Leave empty to disable VK publishing.
VK_COMMUNITY_ID=""
# Service token with the rights: access to community messages, photos.upload.
# Also settable from /admin/settings.
VK_ACCESS_TOKEN=""

# Telegram auto-posting.
# The token and the channel are editable in /admin/settings; these are the fallbacks
# used when the database has no row, and the only place to set them before first run.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
# Alternative Bot API root, for when api.telegram.org is unreachable from the host.
# Measured: TCP 443 to api.telegram.org never completes on the project's VPS, so
# publishing fails at the connection. Point this at your own reverse proxy or a
# Cloudflare Worker that forwards to api.telegram.org. Editable in /admin/settings too.
# https only (http is allowed for localhost). Leave empty for the official address.
TELEGRAM_API_ROOT=""

# Outbound proxy for Telegram calls, for the same blocked-egress case. Deliberately
# environment-only, never a settings field: a proxy URL usually carries credentials,
# and the server-side value is the trust boundary. http://, https:// and socks5://
# are accepted by undici's ProxyAgent. Leave empty for a direct connection.
# Example: http://user:password@proxy.internal:3128
TELEGRAM_PROXY=""

# MAX auto-posting.
# Needs a verified profile on the MAX partner platform; the certificate authority of
# the Ministry of Digital Development must be trusted by the runtime, which
# deploy.sh arranges through NODE_EXTRA_CA_CERTS. See ecosystem.config.cjs.
MAX_BOT_TOKEN=""
MAX_CHAT_ID=""

# Analytics (public pages only). Empty means the counter is not rendered at all,
# rather than sending readers' data to whichever counter a default number belongs to.
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
# Session recording. Records what a visitor types, including the forum form.
NEXT_PUBLIC_YANDEX_METRIKA_WEBVISOR="true"

# AI cover generation (/admin → "Сгенерировать обложку").
# DeepSeek rewrites a Russian story into an English photography prompt;
# DeepInfra's FLUX-1-schnell renders it at 1024×576.
# Both are optional: with either key missing the endpoint answers 503 with a
# readable message and the editor's upload button keeps working.
DEEPSEEK_API_KEY=""
DEEPINFRA_API_KEY=""

# Editorial area credentials (HTTP Basic Auth, enforced in src/proxy.ts).
# CHANGE THESE before the journalist goes live — these defaults are public.
ADMIN_USER="admin"
ADMIN_PASSWORD="admin123"
