// Prisma schema — SQLite (dev.db)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// SQLite has no native enum type, so `status` is a String constrained in app
// code by the `ArticleStatus` union (see src/lib/article-status.ts).
model Article {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  slug        String    @unique
  lead        String?
  contentHtml String
  coverImage  String?
  // Photo credit, printed in italics under the cover.
  photoAuthor String?
  photoSource String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  // Distribution flags from the editorial sidebar.
  isDzen      Boolean   @default(true)
  isVk        Boolean   @default(true)
  isExclusive Boolean   @default(false)
  is18plus    Boolean   @default(false)
  // "draft" | "published"
  status      String    @default("draft")
  // Editorial overrides for the page metadata. All optional: the article page
  // falls back to title / lead / cover when a field is empty, so an editor only
  // fills in what the automatic version gets wrong.
  seoTitle        String?
  seoDescription  String?
  // Set when the story is a reprint hosted elsewhere and should point at the
  // original, which is the usual fix for duplicate-content penalties.
  seoCanonicalUrl String?
  // Keeps a published story out of search indexes: syndicated wire copy, legal
  // notices, embargoed material.
  noIndex         Boolean   @default(false)
  /// Gallery attached to the story: [{ type, url, caption, source, width, height }].
  /// Stored as JSON rather than a join table because an image has no fields
  /// worth querying on, it is only ever read as an ordered list with the article.
  media            Json?
  /// Link to the story's main video — VK Video, Rutube or YouTube. Rendered as an
  /// embedded player on the site and as a plain link in the RSS feed, which is
  /// how Dzen turns it into a widget.
  videoUrl         String?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  // Dzen syndication experiment, per editorial rule: it can only be switched on at
  // the moment of first publication. Enforced server-side in actions.ts, not just
  // by disabling the checkbox — see src/lib/dzen-experiment.ts.
  //
  // Appended at the end on purpose: SQLite can only ADD COLUMN at the end of a
  // table, so inserting these among the other flags made Prisma rebuild the whole
  // Article table instead of adding two columns.
  dzenExperiment Boolean @default(false)
  // Publish straight into Dzen instead of holding the item for review. Only has an
  // effect together with dzenExperiment, which is the stronger claim.
  dzenDirect     Boolean @default(false)
  // Lowercased "title lead" copy, used only by the editor's article search.
  //
  // Measured, not assumed: SQLite's LIKE and even LOWER() are ASCII-only, so
  // `contains: "транспорт"` finds nothing in a title stored as "Транспорт" — and
  // COLLATE NOCASE behaves the same, the reason Tag carries nameKey. Same solution
  // here: fold the case in JS, where toLowerCase() handles Cyrillic, and search
  // the folded column.
  searchText     String?
  tags        ArticleTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

/**
 * Editorial tag. Modelled explicitly rather than as a bare Prisma m-n so the
 * join table can carry its own indexes and cascade cleanly.
 *
 * `nameKey` is a lowercased copy of `name` and carries the uniqueness. The
 * design asked for COLLATE NOCASE instead, but SQLite's built-in NOCASE folds
 * ASCII only: measured against a scratch table it rejected "artificial
 * intelligence" as a duplicate of "Artificial Intelligence" while happily
 * accepting both "Искусственный интеллект" and "искусственный интеллект". For a
 * Russian site that is no dedup at all, so the key is computed in JS, where
 * toLowerCase() handles every letter the site actually uses.
 */
model Tag {
  id        Int          @id @default(autoincrement())
  name      String
  nameKey   String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  articles  ArticleTag[]
}

/// Join row between an article and a tag.
model ArticleTag {
  articleId String
  tagId     Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

/**
 * Editor-managed configuration, stored as plain key/value rows.
 *
 * Exists so an API key can be changed from /admin/settings without editing .env
 * and restarting pm2. The key names are the same environment variable names, and
 * a row here overrides the environment — see src/lib/settings.ts.
 *
 * Only the names listed in ALLOWED_KEYS there are readable or writable through
 * the API. A generic settings endpoint would otherwise hand out every secret the
 * process has, ADMIN_PASSWORD included.
 */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

// --- forum -------------------------------------------------------------------
//
// A reader discussion board. Separate tables rather than a comment column on
// Article: a forum thread outlives the story it was started from, and a thread can
// be about anything — which is also why posts carry no user accounts. Everything
// here is anonymous by design, with a display name typed into the form.
//
// Tables and columns are mapped to snake_case explicitly. The rest of the schema
// uses Prisma's default PascalCase, so this is a deliberate difference: the forum
// tables are named in the data-layer vocabulary rather than the ORM's, and
// `@@map` is what makes the SQL match the specification instead of
// "ForumCategory".

/// A forum section. `orderIndex` is set by hand and sorts the board.
model ForumCategory {
  id          Int          @id @default(autoincrement())
  title       String
  slug        String       @unique
  description String?
  orderIndex  Int          @default(0) @map("order_index")
  topics      ForumTopic[]

  @@map("forum_categories")
}

/// A thread. `viewsCount` is incremented by the public page, not by an endpoint,
/// so it counts rendered reads rather than requests that were never followed.
model ForumTopic {
  id         Int          @id @default(autoincrement())
  categoryId Int          @map("category_id")
  title      String
  slug       String       @unique
  authorName String       @map("author_name")
  isPinned   Boolean      @default(false) @map("is_pinned")
  isClosed   Boolean      @default(false) @map("is_closed")
  viewsCount Int          @default(0) @map("views_count")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  posts      ForumPost[]

  @@index([categoryId, isPinned, updatedAt])
  @@map("forum_topics")
}

/// A message in a thread. Deleting the thread cascades here, so /admin has one
/// button to remove a whole discussion.
model ForumPost {
  id         Int      @id @default(autoincrement())
  topicId    Int      @map("topic_id")
  authorName String   @map("author_name")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  topic      ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
  @@map("forum_posts")
}
